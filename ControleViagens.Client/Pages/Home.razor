@page "/"

<PageTitle>Controle de Viagens</PageTitle>

<section class="welcome-row">
	<div class="welcome-copy-block">
		<img class="home-brand-logo" src="images/keia-panstein.svg" alt="Keia Panstein" />
		<h1>Controle de Viagens</h1>
		<p class="welcome-copy">Passageiros, trajetos e viagens reunidos em um só lugar.</p>
	</div>
	<div class="journey-infographic" role="img" aria-label="Fluxo do sistema: Passageiros, Trechos, Viagens e Consultas">
		<div class="journey-stage"><span class="journey-node"></span><span>Passageiros</span></div>
		<div class="journey-stage"><span class="journey-node"></span><span>Trechos</span></div>
		<div class="journey-stage"><span class="journey-node"></span><span>Viagens</span></div>
		<div class="journey-stage"><span class="journey-node"></span><span>Consultas</span></div>
	</div>
</section>

<section class="module-section" aria-labelledby="modules-title">
	<div class="section-heading">
		<div>
			<h2 id="modules-title">Módulos</h2>
		</div>
	</div>

	<div class="module-grid">
		<a class="module-card module-card-green" href="pessoas">
			<span class="module-icon" aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><circle cx="10" cy="6" r="3" /><path d="M4 17v-1a6 6 0 0 1 12 0v1z" /></svg></span>
			<span class="module-title">Passageiros</span>
			<span class="module-arrow" aria-hidden="true">&#8599;</span>
		</a>
		<a class="module-card module-card-lime" href="trechos">
			<span class="module-icon" aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><circle cx="5" cy="15" r="2" /><circle cx="15" cy="5" r="2" /><path d="M7 15h2a3 3 0 0 0 3-3V8a3 3 0 0 1 3-3" /></svg></span>
			<span class="module-title">Trechos</span>
			<span class="module-arrow" aria-hidden="true">&#8599;</span>
		</a>
		<a class="module-card module-card-sage" href="viagens">
			<span class="module-icon" aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><path d="M10 18s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10z" /><circle cx="10" cy="8" r="2" /></svg></span>
			<span class="module-title">Viagens</span>
			<span class="module-arrow" aria-hidden="true">&#8599;</span>
		</a>
		<a class="module-card module-card-coral" href="consultas">
			<span class="module-icon" aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><path d="M5 3h7l3 3v5" /><path d="M12 3v4h4M5 10v7h5" /><circle cx="13" cy="14" r="3" /><path d="m15.2 16.2 2 2" /></svg></span>
			<span class="module-title">Consultas</span>
			<span class="module-arrow" aria-hidden="true">&#8599;</span>
		</a>
		<a class="module-card module-card-gold" href="faturamento">
			<span class="module-icon" aria-hidden="true"><svg viewBox="0 0 20 20" focusable="false"><rect x="3" y="5" width="14" height="10" rx="1.5" /><path d="M3 8.5h14M6 12h3" /></svg></span>
			<span class="module-title">Faturamento</span>
			<span class="module-arrow" aria-hidden="true">&#8599;</span>
		</a>
	</div>
</section>
