@typeparam TItem where TItem : class
@implements IDisposable

@* Combobox that searches the source table while the user types and only accepts an item picked from the list. *@
<div class="lookup-field">
    <input id="@Id"
           class="passenger-name-input passenger-create-input lookup-input @(Selected is not null ? "is-selected" : null)"
           type="text"
           role="combobox"
           autocomplete="off"
           aria-autocomplete="list"
           aria-expanded="@(_isOpen ? "true" : "false")"
           aria-controls="@ListId"
           aria-activedescendant="@ActiveDescendant"
           placeholder="@Placeholder"
           value="@_text"
           disabled="@Disabled"
           @oninput="OnInputAsync"
           @onfocus="OnFocusAsync"
           @onblur="Close"
           @onkeydown="OnKeyDownAsync" />

    @if (_isOpen)
    {
        <ul id="@ListId" class="lookup-list" role="listbox">
            @if (_hasError)
            {
                <li class="lookup-status lookup-status-error">Não foi possível buscar. Verifique a conexão com o servidor.</li>
            }
            else if (_isSearching && _items.Count == 0)
            {
                <li class="lookup-status">Buscando...</li>
            }
            else if (_items.Count == 0)
            {
                <li class="lookup-status">Nenhum resultado para "@_text.Trim()".</li>
            }
            else
            {
                @for (var index = 0; index < _items.Count; index++)
                {
                    var item = _items[index];
                    var optionIndex = index;
                    <li id="@OptionId(optionIndex)"
                        class="lookup-option @(optionIndex == _activeIndex ? "is-active" : null)"
                        role="option"
                        aria-selected="@(optionIndex == _activeIndex ? "true" : "false")"
                        @onmousedown="() => SelectAsync(item)"
                        @onmousedown:preventDefault>
                        <span class="lookup-option-text">@ItemText(item)</span>
                        @if (ItemDetail is not null)
                        {
                            <span class="lookup-option-detail">@ItemDetail(item)</span>
                        }
                    </li>
                }
            }
        </ul>
    }
</div>

@code {
    private const int DebounceMilliseconds = 250;

    private CancellationTokenSource? _searchCancellation;
    private List<TItem> _items = [];
    private TItem? _lastSelected;
    private string _text = string.Empty;
    private int _activeIndex = -1;
    private bool _isOpen;
    private bool _isSearching;
    private bool _hasError;

    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Func<string, CancellationToken, Task<IReadOnlyList<TItem>>> Search { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> ItemText { get; set; } = default!;
    [Parameter] public Func<TItem, string>? ItemDetail { get; set; }
    [Parameter] public TItem? Selected { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private string ListId => $"{Id}-lista";
    private string? ActiveDescendant => _isOpen && _activeIndex >= 0 && _activeIndex < _items.Count ? OptionId(_activeIndex) : null;
    private string OptionId(int index) => $"{Id}-opcao-{index}";

    protected override void OnParametersSet()
    {
        // Reflects a selection made by the parent, such as opening the dialog to edit a trip.
        if (!ReferenceEquals(Selected, _lastSelected))
        {
            _lastSelected = Selected;
            _text = Selected is null ? string.Empty : ItemText(Selected);
        }
    }

    private async Task OnInputAsync(ChangeEventArgs eventArgs)
    {
        _text = eventArgs.Value?.ToString() ?? string.Empty;
        if (Selected is not null)
        {
            _lastSelected = null;
            await SelectedChanged.InvokeAsync(null);
        }

        await SearchAsync();
    }

    private async Task OnFocusAsync()
    {
        if (Selected is null)
        {
            await SearchAsync();
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs eventArgs)
    {
        switch (eventArgs.Key)
        {
            case "ArrowDown" when !_isOpen:
                await SearchAsync();
                break;
            case "ArrowDown" when _items.Count > 0:
                _activeIndex = Math.Min(_activeIndex + 1, _items.Count - 1);
                break;
            case "ArrowUp" when _isOpen && _items.Count > 0:
                _activeIndex = Math.Max(_activeIndex - 1, 0);
                break;
            case "Enter" when _isOpen && _activeIndex >= 0 && _activeIndex < _items.Count:
                await SelectAsync(_items[_activeIndex]);
                break;
            case "Escape":
                Close();
                break;
        }
    }

    private async Task SearchAsync()
    {
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        var cancellationToken = _searchCancellation.Token;

        _isOpen = true;
        _isSearching = true;
        _hasError = false;
        try
        {
            await Task.Delay(DebounceMilliseconds, cancellationToken);
            var items = await Search(_text.Trim(), cancellationToken);
            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            _items = [.. items];
            _activeIndex = _items.Count > 0 ? 0 : -1;
            _isSearching = false;
        }
        catch (OperationCanceledException)
        {
            // A newer search replaced this one.
        }
        catch (HttpRequestException)
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                _items = [];
                _hasError = true;
                _isSearching = false;
            }
        }
    }

    private async Task SelectAsync(TItem item)
    {
        _lastSelected = item;
        _text = ItemText(item);
        Close();
        await SelectedChanged.InvokeAsync(item);
    }

    private void Close()
    {
        _searchCancellation?.Cancel();
        _isOpen = false;
        _isSearching = false;
        _activeIndex = -1;
    }

    public void Dispose()
    {
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
    }
}
